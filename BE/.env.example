# Konfigurasi Database Supabase
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASS=
# require untuk Supabase; disable hanya untuk PostgreSQL lokal
DB_SSLMODE=require

# Konfigurasi Aplikasi
APP_ENV=local
APP_DEBUG=
CORS_ORIGIN=http://127.0.0.1:5500

# Autentikasi area PJ (kelola-*, dashboard-pj)
#   dev      : header X-Dev-Nim dipercaya; HANYA jalan bila APP_ENV=local (untuk Postman/uji lokal)
#   supabase : header Authorization: Bearer <access_token> divalidasi ke Supabase Auth (produksi)
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
