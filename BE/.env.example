# Catatan: komentar hanya boleh di baris sendiri (jangan di belakang nilai).

# ---- Aplikasi
# APP_ENV: local atau production
APP_ENV=local
# URL BE (dipakai untuk tautan berkas pada driver local)
APP_URL=http://localhost:8000
# Dipakai membuat tautan reset password
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGIN=http://localhost:5173

#Database (Supabase > Project Settings > Database)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=isi-password-database
DB_SSLMODE=require

# ---- Token login (HS256 buatan sendiri)
TOKEN_SECRET=
TOKEN_TTL_HOURS=8

# ---- Captcha Cloudflare Turnstile
CAPTCHA_MODE=off
TURNSTILE_SECRET=

# ---- Penyimpanan berkas
# STORAGE_DRIVER: local (folder storage/uploads) atau supabase
STORAGE_DRIVER=local
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key. JANGAN dikirim ke FE.
SUPABASE_SERVICE_KEY=
# Bucket publik: foto barang dan logo OKI
STORAGE_BUCKET_PUBLIK=pinjemdulu-publik
# Bucket privat: foto pengambilan/kondisi dan surat PJ
STORAGE_BUCKET_PRIVAT=pinjemdulu-privat
