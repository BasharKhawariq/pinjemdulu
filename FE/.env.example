# ==============================================================================
# PINJEMDULU FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Pada build statis murni / browser Vanilla JS, variabel ini diinjeksikan melalui
# file `FE/env.js` (window.__ENV__).
# File ini berfungsi sebagai dokumentasi dan acuan konfigurasi runtime.
# ==============================================================================

# URL Basis Backend API PinjemDulu PHP Native
API_BASE_URL=http://localhost:8000

# Toggle Mock API
# false = Konsumsi backend API nyata (http://localhost:8000)
# true  = Gunakan mode simulasi mock lokal (localStorage & in-memory)
ENABLE_MOCK=false

