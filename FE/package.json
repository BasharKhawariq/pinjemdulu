{
  "name": "pinjam-dulu-vanilla",
  "version": "1.0.0",
  "description": "Vanilla JS edition of PinjemDulu static web application",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/app.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/app.css --watch",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4"
  }
}
